{
  "name": "lifeline",
  "private": true,
  "version": "0.1.0",
  "license": "PolyForm-Noncommercial-1.0.0",
  "scripts": {
    "prepare": "node scripts/install-hooks.mjs",
    "check": "node --test scripts/*.test.mjs && node scripts/check-ui.mjs && node scripts/adr.mjs check && node scripts/migrations.mjs check && pnpm -r typecheck && pnpm -r test",
    "check:ui": "node scripts/check-ui.mjs",
    "adr:new": "node scripts/adr.mjs new",
    "adr:mv": "node scripts/adr.mjs mv",
    "adr:check": "node scripts/adr.mjs check",
    "migrations:next": "node scripts/migrations.mjs next",
    "migrations:check": "node scripts/migrations.mjs check",
    "worktrees:prune": "node scripts/worktrees.mjs prune",
    "worktree:new": "node scripts/worktrees.mjs new",
    "dev": "pnpm --filter @lifeline/shell dev",
    "dev:all": "node scripts/dev-launcher.mjs",
    "mcp": "pnpm --filter @lifeline/mcp dev",
    "build": "pnpm --filter @lifeline/shell build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "tauri": "pnpm --filter @lifeline/shell tauri",
    "test:e2e": "pnpm --filter @lifeline/shell test:e2e",
    "test:e2e:quiet": "pnpm --filter @lifeline/shell test:e2e:quiet"
  },
  "packageManager": "pnpm@9.11.0",
  "pnpm": {
    "overrides": {
      "brace-expansion@>=4 <5.0.12": "^5.0.12",
      "fast-uri@>=3 <3.1.8": "^3.1.8",
      "hono@<4.13.7": "^4.13.7",
      "ip-address@<10.7.1": "^10.7.1",
      "js-yaml@>=4 <4.3.2": "^4.3.2",
      "postcss-selector-parser@>=7 <7.1.6": "^7.1.6",
      "proxy-addr@<2.0.8": "^2.0.8",
      "qs@<6.16.0": "^6.16.0",
      "source-map-js@<1.2.2": "^1.2.2",
      "undici@>=7 <7.29.1": "^7.29.1"
    }
  }
}
