{
  "name": "lifeline",
  "private": true,
  "version": "0.1.0",
  "license": "PolyForm-Noncommercial-1.0.0",
  "scripts": {
    "check": "node scripts/check-ui.mjs && node scripts/adr.mjs check && node scripts/migrations.mjs check && pnpm -r typecheck && pnpm -r test",
    "check:ui": "node scripts/check-ui.mjs",
    "adr:new": "node scripts/adr.mjs new",
    "adr:mv": "node scripts/adr.mjs mv",
    "adr:check": "node scripts/adr.mjs check",
    "migrations:next": "node scripts/migrations.mjs next",
    "migrations:check": "node scripts/migrations.mjs check",
    "worktrees:prune": "node scripts/worktrees.mjs prune",
    "dev": "pnpm --filter @lifeline/shell dev",
    "dev:all": "node scripts/dev-launcher.mjs",
    "mcp": "pnpm --filter @lifeline/mcp dev",
    "build": "pnpm --filter @lifeline/shell build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "tauri": "pnpm --filter @lifeline/shell tauri",
    "test:e2e": "pnpm --filter @lifeline/shell test:e2e"
  },
  "packageManager": "pnpm@9.11.0"
}
