{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "types": ["vite/client", "node"],
    // vite.config.ts names its imports with their extension, as Vite's native config loader needs.
    "allowImportingTsExtensions": true,
    "baseUrl": ".",
    "paths": { "@/*": ["src/*"] }
  },
  "include": ["src", "build", "vite.config.ts", "vitest.config.ts"]
}
