{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "https://**"
        },
        {
          "url": "http://**"
        }
      ],
      "deny": [
        {
          "url": "https://localhost{.}?:*"
        },
        {
          "url": "https://*.localhost{.}?:*"
        },
        {
          "url": "https://(0\\.\\d+\\.\\d+\\.\\d+):*"
        },
        {
          "url": "https://(10\\.\\d+\\.\\d+\\.\\d+):*"
        },
        {
          "url": "https://(127\\.\\d+\\.\\d+\\.\\d+):*"
        },
        {
          "url": "https://(169\\.254\\.\\d+\\.\\d+):*"
        },
        {
          "url": "https://(172\\.(?:1[6-9]|2\\d|3[01])\\.\\d+\\.\\d+):*"
        },
        {
          "url": "https://(192\\.168\\.\\d+\\.\\d+):*"
        },
        {
          "url": "https://(100\\.(?:6[4-9]|[7-9]\\d|1[01]\\d|12[0-7])\\.\\d+\\.\\d+):*"
        },
        {
          "url": "https://\\[*\\]:*"
        },
        {
          "url": "https://*.internal{.}?:*"
        },
        {
          "url": "https://*.flycast{.}?:*"
        },
        {
          "url": "https://*.local{.}?:*"
        },
        {
          "url": "https://*.lan{.}?:*"
        },
        {
          "url": "https://*.home.arpa{.}?:*"
        },
        {
          "url": "http://localhost{.}?:*"
        },
        {
          "url": "http://*.localhost{.}?:*"
        },
        {
          "url": "http://(0\\.\\d+\\.\\d+\\.\\d+):*"
        },
        {
          "url": "http://(10\\.\\d+\\.\\d+\\.\\d+):*"
        },
        {
          "url": "http://(127\\.\\d+\\.\\d+\\.\\d+):*"
        },
        {
          "url": "http://(169\\.254\\.\\d+\\.\\d+):*"
        },
        {
          "url": "http://(172\\.(?:1[6-9]|2\\d|3[01])\\.\\d+\\.\\d+):*"
        },
        {
          "url": "http://(192\\.168\\.\\d+\\.\\d+):*"
        },
        {
          "url": "http://(100\\.(?:6[4-9]|[7-9]\\d|1[01]\\d|12[0-7])\\.\\d+\\.\\d+):*"
        },
        {
          "url": "http://\\[*\\]:*"
        },
        {
          "url": "http://*.internal{.}?:*"
        },
        {
          "url": "http://*.flycast{.}?:*"
        },
        {
          "url": "http://*.local{.}?:*"
        },
        {
          "url": "http://*.lan{.}?:*"
        },
        {
          "url": "http://*.home.arpa{.}?:*"
        }
      ]
    }
  ]
}
